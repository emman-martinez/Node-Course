{
  "name": "07-restweb",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run prisma:migrate:test && jest",
    "test:smoke": "npm run prisma:migrate:test && jest --runInBand --bail tests/presentation/todos/routes.test.ts",
    "test:watch": "npm run prisma:migrate:test && jest --watchAll --coverage",
    "test:coverage": "npm run prisma:migrate:test && jest --coverage",
    "dev": "tsnd --respawn --clear src/app.ts",
    "build": "rimraf ./dist && tsc && npm run prisma:migrate:prod",
    "start": "npm run build && node dist/app.js",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:migrate:test": "dotenv -e .env.test -- npx prisma migrate deploy",
    "lint": "eslint src tests scripts --ext .ts,.js",
    "lint:fix": "eslint src tests scripts --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\" \"scripts/**/*.js\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\" \"scripts/**/*.js\" \"*.md\"",
    "commit:msg": "node scripts/generate-commit-message.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:install:unix": "sh scripts/install-hooks.sh",
    "hooks:install:windows": "node scripts/install-hooks.js",
    "hooks:check-commit-msg": "node scripts/validate-commit-msg.js",
    "hooks:pre-commit": "npm run lint && npm run format:check"
  },
  "keywords": [],
  "author": "Emmanuel Martinez",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "prisma": "^7.5.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "pg": "^8.20.0"
  }
}
